<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F3E8"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#F7F3E8">

        <TextView
            android:id="@+id/quran_reader_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="#174C3C"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/quran_surah_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القرآن الكريم"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#17231D"
                android:gravity="center"/>

            <TextView
                android:id="@+id/quran_page_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="صفحة 1 من 604"
                android:textSize="12sp"
                android:textColor="#66736B"
                android:gravity="center"/>
        </LinearLayout>

        <TextView
            android:id="@+id/quran_jump"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="↕"
            android:textSize="23sp"
            android:textColor="#174C3C"
            android:gravity="center"/>

        <TextView
            android:id="@+id/quran_bookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="☆"
            android:textSize="28sp"
            android:textColor="#C69A45"
            android:gravity="center"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D8CCB2"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFDF5"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ"
                android:textSize="18sp"
                android:textColor="#C69A45"
                android:gravity="center"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/quran_verses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D8CCB2"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#F7F3E8">

        <TextView
            android:id="@+id/quran_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="التالي  ›"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#174C3C"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  مصحف المدينة  "
            android:textSize="11sp"
            android:textColor="#66736B"
            android:gravity="center"/>

        <TextView
            android:id="@+id/quran_prev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="‹  السابق"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#174C3C"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>